      "templateId": "FaceOnly"
    },
    {
      "data": {
        "paragraph": "Coach Tampson spent two sessions with VP Chen using open questions and following his lead, but Chen was reserved. By session three, Tampson wondered if she was helping.",
        "title": "Case Example: Tampson and Chen",
        "variant": "paragraph"
      },
      "durationInFrames": 1204,
      "endTime": 1243.47,
      "startTime": 1203.31,
      "templateId": "PostcardParagraph"
    },
    {
      "data": {},
      "durationInFrames": 475,
      "endTime": 1259.33,
      "startTime": 1243.47,
      "templateId": "FaceOnly"
    },
    {
      "data": {
        "paragraph": "Tampson shared observations, explaining she held back to understand before suggesting. She offered to share what she saw if Chen discussed his next steps, leading to Chen's first smile.",
        "title": "Providing Structured Autonomy",
        "variant": "paragraph"
      },
      "durationInFrames": 761,
      "endTime": 1284.71,
      "startTime": 1259.33,
      "templateId": "PostcardParagraph"
