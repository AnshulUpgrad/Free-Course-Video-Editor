      "templateId": "FaceOnly"
    },
    {
      "data": {
        "bullets": [
          "Be explicit about your process and reasons.",
          "Offer a framework for the client to fill in.",
          "Check in on the type of help the client seeks."
        ],
        "title": "Adapting Application of Autonomy",
        "variant": "bullets"
      },
      "durationInFrames": 1127,
      "endTime": 1197.33,
      "startTime": 1159.73,
