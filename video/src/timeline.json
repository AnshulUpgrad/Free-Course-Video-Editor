    },
    {
      "data": {
        "concept": "Autonomy and Client Direction"
      },
      "durationInFrames": 899,
      "endTime": 1014.71,
      "startTime": 984.73,
      "templateId": "ConceptCard"
    },
    {
      "data": {
        "definition": "The client is the author of their own development: they set the direction, define success, and choose what to explore and act on. The coach follows their lead.",
        "term": "Autonomy in Coaching"
      },
      "durationInFrames": 563,
      "endTime": 1033.51,
      "startTime": 1014.71,
      "templateId": "DefinitionCard"
    },
    {
      "data": {},
      "durationInFrames": 861,
      "endTime": 1062.21,
      "startTime": 1033.51,
      "templateId": "FaceOnly"
    },
    {
      "data": {
        "paragraph": "Autonomy does not mean a coach is passive. A coach honoring autonomy actively listens, notices patterns, names observations, and asks questions that stretch the client's thinking. The directional movement comes from the client.",
        "title": "Autonomy vs. Non-Directional",
        "variant": "paragraph"
      },
      "durationInFrames": 1159,
      "endTime": 1100.85,
      "startTime": 1062.21,
      "templateId": "PostcardParagraph"
    },
    {
      "data": {},
      "durationInFrames": 562,
      "endTime": 1119.61,
      "startTime": 1100.85,
      "templateId": "FaceOnly"
    },
    {
      "data": {
        "items": [
          "Clients wanting direct answers",
          "Clients expecting guidance from an authority figure",
          "Imposing a non-directive approach on an unprepared client"
        ],
        "layout": "halfscreen",
        "title": "Limits to Autonomy"
      },
      "durationInFrames": 1015,
      "endTime": 1153.47,
      "startTime": 1119.61,
      "templateId": "BulletList"
    },
    {
      "data": {},
      "durationInFrames": 187,
