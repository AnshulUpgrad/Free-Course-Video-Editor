    {
      "data": {
        "title": "Coaching: Not About Giving Advice",
        "image": "uploads/img_4cea1a8a86674dbc98df4eb7be96920a.png",
        "variant": "paragraph",
        "paragraph": "Coaching isn't about giving advice; it's about forming a partnership that encourages people to think, grow, and ultimately change. In Module 1, we explored what coaching is and isn't, and shifted from problem-solving to facilitating awareness and decision-making."
      },
      "durationInFrames": 853,
      "endTime": 45.86,
      "startTime": 17.4,
      "templateId": "PostcardParagraph"
    },
    {
      "data": {},
      "durationInFrames": 644,
